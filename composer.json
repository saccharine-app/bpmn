{
    "name": "saccharine/bpmn",
    "description": "Saccharine BPMN Execution Engine for Laravel",
    "license": "MIT",
    "keywords": ["laravel", "bpmn", "workflow", "saccharine", "orchestration"],
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/expression-language": "^7.0",
        "durable-workflow/workflow": "^1.0",
        "tightenco/ziggy": "^2.6"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saccharine\\Bpmn\\BpmnServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Saccharine\\Bpmn\\": "src/",
            "Saccharine\\Bpmn\\Database\\Seeders\\": "database/seeders/",
            "Saccharine\\Bpmn\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saccharine\\Bpmn\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Matthew Wegner",
            "email": "mwegner@proton.me"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench workbench:install --ansi --no-interaction --no-devtool",
        "test": "@php vendor/bin/pest --colors=always",
        "serve": "@php vendor/bin/testbench workbench:serve --ansi"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
